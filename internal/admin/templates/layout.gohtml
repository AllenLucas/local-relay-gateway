{{define "layout"}}
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <title>{{.Title}} · Local Relay Gateway</title>
    <script defer src="/admin/assets/admin.js"></script>
    <style>
      :root {
        --bg: #0d1117;
        --bg-elev: #161b22;
        --bg-deep: #0a0e13;
        --border: #30363d;
        --text: #c9d1d9;
        --muted: #8b949e;
        --accent: #7ee787;
        --accent-dim: #3fb950;
        --link: #79c0ff;
        --warn: #d29922;
        --danger: #f85149;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: var(--bg); color: var(--text); }
      body {
        font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", "Fira Code", Menlo, Consolas, monospace;
        font-size: 14px;
        line-height: 1.55;
      }
      header.topbar {
        border-bottom: 1px solid var(--border);
        background: linear-gradient(180deg, #11161d 0%, #0d1117 100%);
        padding: 14px 28px 0 28px;
      }
      header.topbar .brand {
        display: inline-block;
        color: var(--accent);
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-right: 32px;
        padding-bottom: 12px;
      }
      header.topbar .brand::before { content: "▌ "; color: var(--accent-dim); }
      nav.tabs { display: inline-flex; gap: 2px; }
      nav.tabs a {
        color: var(--muted);
        text-decoration: none;
        padding: 8px 14px;
        border: 1px solid transparent;
        border-bottom: none;
        font-size: 13px;
        display: inline-block;
        position: relative;
        top: 1px;
      }
      nav.tabs a:hover { color: var(--text); background: #11161d; }
      nav.tabs a.active {
        color: var(--accent);
        border-color: var(--border);
        background: var(--bg);
      }
      main { padding: 24px 28px 48px 28px; max-width: 1200px; }
      h1 {
        font-size: 18px;
        margin: 0 0 18px 0;
        color: var(--accent);
        font-weight: 600;
        letter-spacing: 0.3px;
      }
      h1::before { content: "$ "; color: var(--accent-dim); }
      h2 {
        font-size: 12px;
        color: var(--muted);
        margin: 28px 0 10px 0;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        font-weight: 600;
      }
      h2::before { content: "# "; color: var(--accent-dim); }
      p { margin: 8px 0; }
      a { color: var(--link); text-decoration: none; }
      a:hover { text-decoration: underline; }
      code {
        color: var(--accent);
        background: var(--bg-deep);
        padding: 1px 6px;
        border: 1px solid var(--border);
        font-size: 12px;
        border-radius: 2px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        background: var(--bg-elev);
        border: 1px solid var(--border);
        font-size: 12.5px;
        margin: 6px 0;
      }
      th {
        background: var(--bg-deep);
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: var(--muted);
        font-size: 11px;
        padding: 9px 12px;
        text-align: left;
        border-bottom: 1px solid var(--border);
        font-weight: 600;
      }
      td {
        padding: 9px 12px;
        border-bottom: 1px solid var(--border);
        color: var(--text);
        vertical-align: top;
      }
      tr:last-child td { border-bottom: none; }
      tr:hover td { background: #1a1f26; }
      td.muted, .muted { color: var(--muted); }

      form.card,
      section.card {
        background: var(--bg-elev);
        border: 1px solid var(--border);
        padding: 16px 20px 18px 20px;
        margin: 10px 0 22px 0;
      }
      fieldset {
        border: 1px solid var(--border);
        padding: 10px 16px 14px 16px;
        margin: 0 0 14px 0;
      }
      fieldset legend {
        color: var(--accent-dim);
        font-size: 11px;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 0 6px;
      }

      .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 18px; }
      .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px 18px; }
      @media (max-width: 720px) {
        .grid-2, .grid-3 { grid-template-columns: 1fr; }
      }

      .field { display: block; }
      .field-label {
        display: block;
        font-size: 12.5px;
        color: var(--text);
        margin-bottom: 3px;
        font-weight: 600;
      }
      .field-label .en { color: var(--muted); font-weight: 400; margin-left: 6px; font-size: 11px; }
      .field-hint {
        display: block;
        font-size: 11.5px;
        color: var(--muted);
        margin: 0 0 5px 0;
      }
      .field input[type=text],
      .field input[type=number],
      .field input[type=password],
      .field input:not([type]),
      .field select,
      .field textarea {
        width: 100%;
        padding: 7px 10px;
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--border);
        font-family: inherit;
        font-size: 13px;
        border-radius: 2px;
      }
      .field input:focus, .field select:focus, .field textarea:focus {
        outline: none;
        border-color: var(--accent-dim);
        box-shadow: 0 0 0 1px var(--accent-dim);
      }
      .field-inline { display: flex; align-items: center; gap: 10px; }
      .field-inline input[type=text],
      .field-inline input[type=password] { flex: 1; }
      .field-check {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--text);
        padding: 4px 0;
      }

      button, .btn {
        background: transparent;
        color: var(--accent);
        border: 1px solid var(--accent-dim);
        padding: 7px 16px;
        font-family: inherit;
        font-size: 13px;
        cursor: pointer;
        border-radius: 2px;
      }
      button:hover, .btn:hover { background: var(--accent-dim); color: var(--bg); }
      button.subtle, .btn.subtle {
        color: var(--muted);
        border-color: var(--border);
      }
      button.subtle:hover, .btn.subtle:hover { background: var(--border); color: var(--text); }

      .actions { display: flex; gap: 10px; align-items: center; margin-top: 6px; }

      .notice {
        border: 1px solid var(--border);
        padding: 10px 14px;
        margin: 12px 0;
        font-size: 13px;
        background: var(--bg-elev);
      }
      .notice.ok { border-color: var(--accent-dim); color: var(--accent); }
      .notice.warn { border-color: var(--warn); color: var(--warn); }
      .notice.err { border-color: var(--danger); color: var(--danger); }

      .pill {
        display: inline-block;
        padding: 1px 8px;
        font-size: 11px;
        border: 1px solid var(--border);
        border-radius: 10px;
        color: var(--muted);
      }
      .pill.ok { color: var(--accent); border-color: var(--accent-dim); }
      .pill.bad { color: var(--danger); border-color: var(--danger); }
      .pill.warn { color: var(--warn); border-color: var(--warn); }
    </style>
  </head>
  <body>
    <header class="topbar">
      <span class="brand">local-relay-gateway</span>
      <nav class="tabs">
        <a href="/admin/runtime">Runtime</a>
        <a href="/admin/sync">Sync</a>
        <a href="/admin/stations">Stations</a>
        <a href="/admin/mappings">Mappings</a>
        <a href="/admin/status">Status</a>
        <a href="/admin/logs">Logs</a>
      </nav>
    </header>
    <main>
      {{template "content" .}}
    </main>
  </body>
</html>
{{end}}
