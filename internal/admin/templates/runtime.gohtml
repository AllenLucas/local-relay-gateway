{{define "content"}}
<h1>Runtime</h1>
{{if .Saved}}
<p style="padding: 12px; background: #fff4d6; border: 1px solid #e7c76d;">Saved. Restart required before the new local key is used by relay endpoints.</p>
{{end}}
{{if .RuntimeError}}
<p style="padding: 12px; background: #ffe8e8; border: 1px solid #d88a8a;">{{.RuntimeError}}</p>
{{end}}
<section style="margin: 16px 0 24px 0; display: grid; gap: 12px; max-width: 820px;">
  <p>Copy these local client endpoints. Runtime changes are written to disk, but this running process keeps using the current startup configuration until restart.</p>
  <label>
    OpenAI base URL
    <input readonly data-copy-source id="openai-url" value="{{.OpenAIBaseURL}}">
    <button type="button" data-copy-target="openai-url">Copy</button>
  </label>
  <label>
    Anthropic base URL
    <input readonly data-copy-source id="anthropic-url" value="{{.AnthropicURL}}">
    <button type="button" data-copy-target="anthropic-url">Copy</button>
  </label>
</section>

<form method="post" action="/admin/runtime" style="margin: 16px 0 24px 0; display: grid; gap: 8px; max-width: 720px;">
  <input type="hidden" name="write_token" value="{{.WriteToken}}">
  <label>
    Local API key
    <input id="local-api-key" name="local_api_key" type="password" value="{{.LocalAPIKey}}" required autocomplete="new-password">
    <button type="button" data-toggle-password="local-api-key">Show</button>
    <button type="button" data-copy-target="local-api-key">Copy</button>
  </label>
  <p style="margin: 0; color: #51606f;">Runtime file: <code>{{.RuntimeFilePath}}</code></p>
  <p style="margin: 0; color: #8a5a00;">Restart required after saving changes.</p>
  <button type="submit">Save Runtime</button>
</form>
{{end}}
