{{define "content"}}
<h1>Logs &amp; Statistics / 日志与统计</h1>
<p class="muted">最近 50 条请求与失败切换事件，按时间倒序。</p>

<h2>Recent Requests / 最近请求</h2>
<table>
  <thead>
    <tr>
      <th>协议</th>
      <th>别名</th>
      <th>站点</th>
      <th>状态码</th>
      <th>耗时(ms)</th>
      <th>流式</th>
      <th>切换</th>
      <th>错误类型</th>
      <th>Input Tokens</th>
      <th>Output Tokens</th>
      <th>Total Tokens</th>
      <th>时间</th>
    </tr>
  </thead>
  <tbody>
    {{range .RequestLogs}}
    <tr>
      <td>{{.Protocol}}</td>
      <td>{{.Alias}}</td>
      <td>{{.StationName}}</td>
      <td>
        {{if ge .StatusCode 500}}<span class="pill bad">{{.StatusCode}}</span>
        {{else if ge .StatusCode 400}}<span class="pill warn">{{.StatusCode}}</span>
        {{else}}<span class="pill ok">{{.StatusCode}}</span>{{end}}
      </td>
      <td>{{.DurationMS}}</td>
      <td class="muted">{{if .WasStream}}yes{{else}}no{{end}}</td>
      <td class="muted">{{if .DidFailover}}<span class="pill warn">failover</span>{{else}}—{{end}}</td>
      <td class="muted">{{if .ErrorKind}}{{.ErrorKind}}{{else}}—{{end}}</td>
      <td>{{.InputTokens}}</td>
      <td>{{.OutputTokens}}</td>
      <td>{{.TotalTokens}}</td>
      <td class="muted"><time datetime="{{.CreatedAt.Format "2006-01-02T15:04:05Z07:00"}}" data-local-time>{{.CreatedAt.Format "2006-01-02 15:04:05 UTC"}}</time></td>
    </tr>
    {{else}}
    <tr><td colspan="12" class="muted">No request logs recorded yet. / 暂无请求日志。</td></tr>
    {{end}}
  </tbody>
</table>

<h2>Failover Events / 失败切换事件</h2>
<table>
  <thead>
    <tr>
      <th>协议</th>
      <th>别名</th>
      <th>From</th>
      <th>To</th>
      <th>原因</th>
      <th>时间</th>
    </tr>
  </thead>
  <tbody>
    {{range .FailoverEvents}}
    <tr>
      <td>{{.Protocol}}</td>
      <td>{{.Alias}}</td>
      <td>{{.FromStationName}}</td>
      <td>{{.ToStationName}}</td>
      <td class="muted">{{.Reason}}</td>
      <td class="muted"><time datetime="{{.CreatedAt.Format "2006-01-02T15:04:05Z07:00"}}" data-local-time>{{.CreatedAt.Format "2006-01-02 15:04:05 UTC"}}</time></td>
    </tr>
    {{else}}
    <tr><td colspan="6" class="muted">No failover events recorded yet. / 暂无切换事件。</td></tr>
    {{end}}
  </tbody>
</table>

<h2>Daily Token Usage / 每日 Token 使用量</h2>
<p class="muted">按 UTC 日期、协议、别名和站点汇总；只统计上游响应中实际返回的 usage 字段。</p>
<table>
  <thead>
    <tr>
      <th>日期(UTC)</th>
      <th>协议</th>
      <th>别名</th>
      <th>站点</th>
      <th>请求数</th>
      <th>计入请求</th>
      <th>Input Tokens</th>
      <th>Output Tokens</th>
      <th>Total Tokens</th>
    </tr>
  </thead>
  <tbody>
    {{range .DailyTokenUsage}}
    <tr>
      <td>{{.Day}}</td>
      <td>{{.Protocol}}</td>
      <td>{{.Alias}}</td>
      <td>{{.StationName}}</td>
      <td>{{.RequestCount}}</td>
      <td>{{.CountedRequests}}</td>
      <td>{{.InputTokens}}</td>
      <td>{{.OutputTokens}}</td>
      <td>{{.TotalTokens}}</td>
    </tr>
    {{else}}
    <tr><td colspan="9" class="muted">No token usage data available. / 暂无 Token 使用量数据。</td></tr>
    {{end}}
  </tbody>
</table>

<h2>Usage By Station / 按站点统计</h2>
<table>
  <thead>
    <tr>
      <th>站点</th>
      <th>别名</th>
      <th>请求数</th>
      <th>错误数</th>
    </tr>
  </thead>
  <tbody>
    {{range .UsageByStation}}
    <tr>
      <td>{{.StationName}}</td>
      <td>{{.Alias}}</td>
      <td>{{.RequestCount}}</td>
      <td>{{if gt .ErrorCount 0}}<span class="pill bad">{{.ErrorCount}}</span>{{else}}0{{end}}</td>
    </tr>
    {{else}}
    <tr><td colspan="4" class="muted">No usage data available. / 暂无数据。</td></tr>
    {{end}}
  </tbody>
</table>

<h2>Usage By Alias / 按别名统计</h2>
<table>
  <thead>
    <tr>
      <th>别名</th>
      <th>站点</th>
      <th>请求数</th>
      <th>错误数</th>
    </tr>
  </thead>
  <tbody>
    {{range .UsageByAlias}}
    <tr>
      <td>{{.Alias}}</td>
      <td>{{.StationName}}</td>
      <td>{{.RequestCount}}</td>
      <td>{{if gt .ErrorCount 0}}<span class="pill bad">{{.ErrorCount}}</span>{{else}}0{{end}}</td>
    </tr>
    {{else}}
    <tr><td colspan="4" class="muted">No alias usage data available. / 暂无数据。</td></tr>
    {{end}}
  </tbody>
</table>

<h2>Upstream Errors / 上游透传错误</h2>
<table>
  <thead>
    <tr>
      <th>协议</th>
      <th>别名</th>
      <th>站点</th>
      <th>状态码</th>
      <th>分类</th>
      <th>详情</th>
      <th>时间</th>
    </tr>
  </thead>
  <tbody>
    {{range .UpstreamErrors}}
    <tr>
      <td>{{.Protocol}}</td>
      <td>{{.Alias}}</td>
      <td>{{.StationName}}</td>
      <td>
        {{if ge .StatusCode 500}}<span class="pill bad">{{.StatusCode}}</span>
        {{else}}<span class="pill warn">{{.StatusCode}}</span>{{end}}
      </td>
      <td class="muted">{{.ErrorKind}}</td>
      <td>
        <details>
          <summary>body{{if .Truncated}} (truncated){{end}}</summary>
          <pre style="white-space: pre-wrap; max-width: 720px; overflow-x: auto;">{{.Body}}</pre>
          <p class="muted">headers: {{.Headers}}</p>
        </details>
      </td>
      <td class="muted"><time datetime="{{.CreatedAt.Format "2006-01-02T15:04:05Z07:00"}}" data-local-time>{{.CreatedAt.Format "2006-01-02 15:04:05 UTC"}}</time></td>
    </tr>
    {{else}}
    <tr><td colspan="7" class="muted">No upstream error details recorded yet. / 暂无上游透传错误详情。</td></tr>
    {{end}}
  </tbody>
</table>
{{end}}
